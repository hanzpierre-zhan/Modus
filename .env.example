# Modus utiliza variables independientes de Nucleus.
MODUS_DATABASE_URL=sqlite:///C:/Mega/Proyect/Modus/modus.db
# En despliegue, definir una clave propia y estable.
MODUS_SECRET_KEY=
MODUS_ADMIN_USERNAME=admin
MODUS_ADMIN_PASSWORD=
PORT=5002
# Adjuntos cloud opcionales: usar un bucket y cuentas propios de Modus.
MODUS_B2_ENDPOINT_URL=
MODUS_B2_KEY_ID=
MODUS_B2_APP_KEY=
MODUS_B2_BUCKET=
MODUS_B2_REGION=us-west-004
MODUS_OD_CLIENT_ID=
MODUS_OD_CLIENT_SECRET=
MODUS_OD_REFRESH_TOKEN=
